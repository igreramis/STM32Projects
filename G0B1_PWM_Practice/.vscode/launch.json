    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug (OpenOCD)",
            "type": "cortex-debug",
            "request": "launch",
            "servertype": "openocd",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/Debug/G0B1_PWM_Practice.elf",
            "preLaunchTask": "build",
            "device": "STM32G0B1RE",
            "interface": "swd",
            "runToEntryPoint": "main",
            "serverpath": "${userHome}/tools/openocd/bin/openocd",
            "searchDir": [
                "${userHome}/tools/openocd/openocd/scripts"
            ],
            "configFiles": [
                "board/st_nucleo_g0.cfg"
            ],
            "gdbPath": "/opt/st/stm32cubeide_2.2.0/plugins/com.st.stm32cube.ide.mcu.externaltools.gnu-tools-for-stm32.14.3.rel1.linux64_1.0.100.202602081740/tools/bin/arm-none-eabi-gdb",
            "svdFile": "/opt/st/stm32cubeide_2.2.0/plugins/com.st.stm32cube.ide.mcu.productdb.debug_2.2.500.202605201745/resources/cmsis/STMicroelectronics_CMSIS_SVD/STM32G0B1.svd",
            "showDevDebugOutput": "none"
        },
        {
            "name": "Attach (OpenOCD)",
            "type": "cortex-debug",
            "request": "attach",
            "servertype": "openocd",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/Debug/G0B1_PWM_Practice.elf",
            "device": "STM32G0B1RE",
            "interface": "swd",
            "serverpath": "${userHome}/tools/openocd/bin/openocd",
            "searchDir": [
                "${userHome}/tools/openocd/openocd/scripts"
            ],
            "configFiles": [
                "board/st_nucleo_g0.cfg"
            ],
            "gdbPath": "/opt/st/stm32cubeide_2.2.0/plugins/com.st.stm32cube.ide.mcu.externaltools.gnu-tools-for-stm32.14.3.rel1.linux64_1.0.100.202602081740/tools/bin/arm-none-eabi-gdb",
            "svdFile": "/opt/st/stm32cubeide_2.2.0/plugins/com.st.stm32cube.ide.mcu.productdb.debug_2.2.500.202605201745/resources/cmsis/STMicroelectronics_CMSIS_SVD/STM32G0B1.svd",
            "showDevDebugOutput": "none"
        }
    ]
