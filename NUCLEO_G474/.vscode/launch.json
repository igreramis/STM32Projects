{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "G474 Debug (OpenOCD)",
            "type": "cortex-debug",
            "request": "launch",
            "servertype": "openocd",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/Debug/NUCLEO_G474.elf",
            "device": "STM32G474RE",
            "interface": "swd",
            "runToEntryPoint": "main",
            "serverpath": "${userHome}/tools/openocd/bin/openocd",
            "searchDir": ["${userHome}/tools/openocd/openocd/scripts"],
            "configFiles": ["board/st_nucleo_g4.cfg"],
            "gdbPath": "${userHome}/.local/share/stm32cube/bundles/gnu-gdb-for-stm32/14.3.1+st.2/bin/arm-none-eabi-gdb",
            "svdFile": "${userHome}/.local/share/stm32cube/packs/STMicroelectronics/stm32g4xx_dfp/1.2.0/SVD/STM32G474.svd",
            "showDevDebugOutput": "none"
        },
        {
            "name": "G474 Attach (OpenOCD)",
            "type": "cortex-debug",
            "request": "attach",
            "servertype": "openocd",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/Debug/NUCLEO_G474.elf",
            "device": "STM32G474RE",
            "interface": "swd",
            "serverpath": "${userHome}/tools/openocd/bin/openocd",
            "searchDir": ["${userHome}/tools/openocd/openocd/scripts"],
            "configFiles": ["board/st_nucleo_g4.cfg"],
            "gdbPath": "${userHome}/.local/share/stm32cube/bundles/gnu-gdb-for-stm32/14.3.1+st.2/bin/arm-none-eabi-gdb",
            "svdFile": "${userHome}/.local/share/stm32cube/packs/STMicroelectronics/stm32g4xx_dfp/1.2.0/SVD/STM32G474.svd",
            "showDevDebugOutput": "none"
        }
    ]
}